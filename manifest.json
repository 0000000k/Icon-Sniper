{
  "manifest_version": 3,
  "name": "Icon Sniper — Copy original SVG to Figma",
  "short_name": "Icon Sniper",
  "version": "0.3.0",
  "description": "Copy original SVG vectors from websites to Figma. DOM-first extraction, SVG sprites, CSS masks; never substitute traced screenshots.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Icon Sniper: select original SVG",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
